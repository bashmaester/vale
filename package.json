{
  "name": "vale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A silent 20-second 3D-to-2D print film of a rainy Tokyo crossing.",
  "scripts": {
    "build": "node build.mjs",
    "docs": "node scripts/update-docs.mjs",
    "deploy:local": "npm run build && npm run docs",
    "dev": "npm run build && python3 -m http.server 8000 --bind 0.0.0.0",
    "check": "esbuild src/main.js --bundle --format=iife --outfile=/tmp/vale-check.js",
    "stills": "node tools/shot.mjs",
    "lod": "node tools/lod.mjs",
    "smoke": "node tools/smoke.mjs",
    "boot": "node tools/boot-smoke.mjs",
    "verify": "npm run check && npm run build && npm run boot && npm run boot:bundle && npm run renderer && npm run finite && npm run determinism",
    "finite": "node tools/finite.mjs",
    "determinism": "node tools/determinism.mjs",
    "renderer": "node tools/renderer-smoke.mjs",
    "boot:bundle": "node tools/boot-bundle.mjs --gl"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "esbuild": "^0.25.12"
  }
}
